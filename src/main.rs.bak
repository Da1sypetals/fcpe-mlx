use std::collections::HashMap;

use anyhow::Result;
use mlx_rs::linalg::norm_l2;
use mlx_rs::module::Module;
use mlx_rs::nn::{Conv1d, GroupNorm, LayerNorm, Linear};
use mlx_rs::ops::indexing::IndexOp;
use mlx_rs::ops::transpose_axes;
use mlx_rs::{array, Array};

fn load_weights(dir: &str) -> Result<HashMap<String, Array>> {
    let mut weights = HashMap::new();
    for entry in std::fs::read_dir(dir)? {
        let entry = entry?;
        let path = entry.path();
        if let Some(name) = path.file_stem().and_then(|s| s.to_str()) {
            if name.starts_with("weight_") {
                let key = name.strip_prefix("weight_").unwrap().to_string();
                let arr = Array::load_numpy(&path)?;
                weights.insert(key, arr);
            }
        }
    }
    Ok(weights)
}

fn get_weight(weights: &HashMap<String, Array>, key: &str) -> Array {
    weights.get(key).cloned().unwrap_or_else(|| panic!("missing weight: {}", key))
}

fn apply_weight_norm(weight_v: &Array, weight_g: &Array) -> Array {
    // weight = weight_g * weight_v / ||weight_v||
    // For linear: weight_v shape [out, in], weight_g shape [out, 1]
    let norm = norm_l2(weight_v, &[-1], true).unwrap();
    let normed = weight_v / (norm + array!(1e-8f32));
    weight_g * normed
}

struct ConformerConvModule {
    norm: LayerNorm,
    conv1: Conv1d,
    dw_conv: Conv1d,
    conv2: Conv1d,
}

impl ConformerConvModule {
    fn new(weights: &HashMap<String, Array>, prefix: &str) -> Result<Self> {
        let norm = LayerNorm::new(512)?;
        // Set norm weights manually
        // (will do after creation)

        let conv1 = Conv1d::new(512, 1024 * 2, 1)?;
        let dw_conv = Conv1d::new(1024, 1024, 31)?;
        let conv2 = Conv1d::new(1024, 512, 1)?;

        let mut module = Self {
            norm,
            conv1,
            dw_conv,
            conv2,
        };
        module.load_weights(weights, prefix)?;
        Ok(module)
    }

    fn load_weights(&mut self, weights: &HashMap<String, Array>, prefix: &str) -> Result<()> {
        // norm
        self.norm.weight.value = Some(get_weight(weights, &format!("{}_norm_weight", prefix)));
        self.norm.bias.value = Some(get_weight(weights, &format!("{}_norm_bias", prefix)));

        // conv1: (1024*2, 1, 512) in mlx -> PyTorch is (2048, 512, 1)
        // Need to transpose PyTorch weight from [out, in, k] to [out, k, in]
        let w1 = get_weight(weights, &format!("{}_conformer_net_2_weight", prefix));
        let w1_t = transpose_axes(&w1, &[0, 2, 1])?;
        self.conv1.weight.value = w1_t;
        self.conv1.bias.value = Some(get_weight(weights, &format!("{}_conformer_net_2_bias", prefix)));

        // dw_conv: PyTorch weight is (1024, 1, 31), groups=1024
        // mlx weight should be (1024, 31, 1) ???
        // Actually for depthwise conv in channels-last: weight is [out_ch, k, in_ch]
        // But groups=out_ch, so each filter only sees 1 input channel
        // PyTorch: (1024, 1, 31) with groups=1024
        // mlx: we need [1024, 31, 1] with groups=1024
        let w_dw = get_weight(weights, &format!("{}_conformer_net_4_conv_weight", prefix));
        let w_dw_t = transpose_axes(&w_dw, &[0, 2, 1])?;
        self.dw_conv.weight.value = w_dw_t;
        self.dw_conv.bias.value = Some(get_weight(weights, &format!("{}_conformer_net_4_conv_bias", prefix)));
        self.dw_conv.groups = 1024;
        self.dw_conv.padding = 15;

        // conv2: PyTorch (512, 1024, 1) -> mlx (512, 1, 1024)
        let w2 = get_weight(weights, &format!("{}_conformer_net_6_weight", prefix));
        let w2_t = transpose_axes(&w2, &[0, 2, 1])?;
        self.conv2.weight.value = w2_t;
        self.conv2.bias.value = Some(get_weight(weights, &format!("{}_conformer_net_6_bias", prefix)));

        Ok(())
    }

    fn forward(&mut self, x: &Array) -> mlx_rs::error::Result<Array> {
        // x: (B, T, C=512)
        // mlx Conv1d expects NLC, same as our input
        let mut y = self.norm.forward(x)?;
        y = self.conv1.forward(&y)?;
        y = mlx_rs::nn::glu(&y, -1)?;
        y = self.dw_conv.forward(&y)?;
        y = mlx_rs::nn::silu(&y)?;
        y = self.conv2.forward(&y)?;
        Ok(y)
    }
}

struct CFNaiveMelPE {
    input_conv1: Conv1d,
    input_gn: GroupNorm,
    input_conv2: Conv1d,
    layers: Vec<ConformerConvModule>,
    norm: LayerNorm,
    output_proj: Linear,
    cent_table: Array,
    gaussian_blurred_cent_mask: Array,
}

impl CFNaiveMelPE {
    fn new(weights: &HashMap<String, Array>) -> Result<Self> {
        let input_conv1 = Conv1d::new(128, 512, 3)?;
        let input_gn = GroupNorm::new(4, 512)?;
        let input_conv2 = Conv1d::new(512, 512, 3)?;
        let norm = LayerNorm::new(512)?;
        let output_proj = Linear::new(512, 360)?;

        let mut model = Self {
            input_conv1,
            input_gn,
            input_conv2,
            layers: Vec::new(),
            norm,
            output_proj,
            cent_table: get_weight(weights, "cent_table"),
            gaussian_blurred_cent_mask: get_weight(weights, "gaussian_blurred_cent_mask"),
        };

        model.load_weights(weights)?;
        Ok(model)
    }

    fn load_weights(&mut self, weights: &HashMap<String, Array>) -> Result<()> {
        // input_stack.0: Conv1d(128, 512, 3)
        let w = get_weight(weights, "input_stack_0_weight");
        self.input_conv1.weight.value = transpose_axes(&w, &[0, 2, 1])?;
        self.input_conv1.bias.value = Some(get_weight(weights, "input_stack_0_bias"));
        self.input_conv1.padding = 1;

        // input_stack.1: GroupNorm(4, 512)
        self.input_gn.weight.value = Some(get_weight(weights, "input_stack_1_weight"));
        self.input_gn.bias.value = Some(get_weight(weights, "input_stack_1_bias"));
        self.input_gn.pytorch_compatible = true;

        // input_stack.3: Conv1d(512, 512, 3)
        let w = get_weight(weights, "input_stack_3_weight");
        self.input_conv2.weight.value = transpose_axes(&w, &[0, 2, 1])?;
        self.input_conv2.bias.value = Some(get_weight(weights, "input_stack_3_bias"));
        self.input_conv2.padding = 1;

        // layers
        for i in 0..6 {
            let prefix = format!("net_encoder_layers_{}", i);
            let layer = ConformerConvModule::new(weights, &prefix)?;
            self.layers.push(layer);
        }

        // norm
        self.norm.weight.value = Some(get_weight(weights, "norm_weight"));
        self.norm.bias.value = Some(get_weight(weights, "norm_bias"));

        // output_proj with weight_norm
        let weight_v = get_weight(weights, "output_proj_weight_v");
        let weight_g = get_weight(weights, "output_proj_weight_g");
        let wn = apply_weight_norm(&weight_v, &weight_g);
        self.output_proj.weight.value = wn;
        self.output_proj.bias.value = Some(get_weight(weights, "output_proj_bias"));

        Ok(())
    }

    fn forward_debug(&mut self, x: &Array) -> mlx_rs::error::Result<(Array, Vec<Array>)> {
        let mut intermediates = Vec::new();

        let mut y = self.input_conv1.forward(x)?;
        intermediates.push(y.clone());
        y = self.input_gn.forward(&y)?;
        intermediates.push(y.clone());
        y = mlx_rs::nn::leaky_relu(&y, 0.01)?;
        intermediates.push(y.clone());
        y = self.input_conv2.forward(&y)?;
        intermediates.push(y.clone());

        for (i, layer) in self.layers.iter_mut().enumerate() {
            let residual = y.clone();
            y = layer.forward(&y)?;
            y = y + residual;
            intermediates.push(y.clone());
        }

        y = self.norm.forward(&y)?;
        intermediates.push(y.clone());
        y = self.output_proj.forward(&y)?;
        intermediates.push(y.clone());
        y = mlx_rs::nn::sigmoid(&y)?;
        intermediates.push(y.clone());

        Ok((y, intermediates))
    }

    fn forward(&mut self, x: &Array) -> mlx_rs::error::Result<Array> {
        let (y, _) = self.forward_debug(x)?;
        Ok(y)
    }
}

fn compare_arrays(name: &str, a: &Array, b: &Array) {
    let diff = (a - b).abs().unwrap();
    let max_diff = diff.max(None).unwrap().item::<f32>();
    let mean_diff = diff.mean(None).unwrap().item::<f32>();
    println!("{}: max_diff={}, mean_diff={}, a_shape={:?}, b_shape={:?}", name, max_diff, mean_diff, a.shape(), b.shape());
}

fn main() {
    println!("Loading weights...");
    let weights = load_weights("/Users/daisy/develop/fcpe-mlxrs").unwrap();
    println!("Loaded {} weights", weights.len());

    let mut model = CFNaiveMelPE::new(&weights).unwrap();

    // Load mel and test
    let mel = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_mel.npy").unwrap();
    println!("Mel shape: {:?}", mel.shape());

    let (latent, inter) = model.forward_debug(&mel).unwrap();
    println!("Latent shape: {:?}", latent.shape());
    let latent_slice = latent.as_slice::<f32>();
    println!("Latent first 5: {:?}", &latent_slice[..5]);

    // Load ref intermediates
    let ref_input_stack = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_input_stack.npy").unwrap();
    let ref_input_stack_t = transpose_axes(&ref_input_stack, &[0, 2, 1]).unwrap();
    compare_arrays("input_stack", &inter[0], &ref_input_stack_t);

    let ref_layer_0 = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_layer_0.npy").unwrap();
    compare_arrays("layer_0", &inter[4], &ref_layer_0);

    let ref_layer_5 = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_layer_5.npy").unwrap();
    compare_arrays("layer_5", &inter[9], &ref_layer_5);

    let ref_norm = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_norm.npy").unwrap();
    compare_arrays("norm", &inter[10], &ref_norm);

    let ref_output_proj = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_output_proj.npy").unwrap();
    compare_arrays("output_proj", &inter[11], &ref_output_proj);

    // Compare with reference latent
    let ref_latent = Array::load_numpy("/Users/daisy/develop/fcpe-mlxrs/ref_latent.npy").unwrap();
    compare_arrays("latent", &latent, &ref_latent);
}
